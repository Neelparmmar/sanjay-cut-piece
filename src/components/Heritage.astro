---
import type { Language } from '../i18n/types';
import { getLanguageFromPath, getTranslations } from '../i18n/utils';

interface Props {
  lang?: Language;
}

const { lang = getLanguageFromPath(Astro.url.pathname) } = Astro.props;
const t = getTranslations(lang);
const milestones = t.heritage.milestones;
---

<section class="heritage section--compact">
  <div class="heritage__inner">
    <div class="heritage__bg-pattern"></div>
    <div class="container" style="position: relative; z-index: 2;">
      <div class="heritage__content reveal">
        <span class="label" style="color: var(--gold-400); display: block; margin-bottom: var(--space-sm);">{t.heritage.label}</span>

        <div class="heritage__year-display">
          <span class="heritage__year shimmer">1977</span>
        </div>

        <h2 class="heading-2" style="color: var(--white); margin-bottom: var(--space-md); text-align: center;">
          {t.heritage.title}
        </h2>

        <p style="font-family: var(--font-display); font-style: italic; font-size: 1.125rem; color: var(--gold-400); text-align: center; margin-bottom: var(--space-3xl); max-width: 600px; margin-left: auto; margin-right: auto; line-height: 1.6;">
          {t.heritage.quote}
        </p>

        <!-- Timeline -->
        <div class="heritage__timeline">
          {milestones.map((item, i) => (
            <div class={`heritage__milestone reveal reveal--delay-${i + 1}`}>
              <div class="heritage__milestone-dot"></div>
              <div class="heritage__milestone-year">{item.year}</div>
              <div class="heritage__milestone-label">{item.label}</div>
              <div class="heritage__milestone-desc">{item.desc}</div>
            </div>
          ))}
        </div>

        <!-- Tagline -->
        <div class="heritage__tagline reveal" style="text-align: center; margin-top: var(--space-3xl);">
          <p style="font-family: var(--font-body); font-size: 0.875rem; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.5);">
            {t.heritage.tagline}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .heritage {
    background: var(--burgundy-900);
    overflow: hidden;
  }

  .heritage__inner {
    position: relative;
    padding: var(--space-4xl) 0;
  }

  .heritage__bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(197, 165, 90, 0.05) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(197, 165, 90, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }

  .heritage__content {
    text-align: center;
  }

  .heritage__year-display {
    margin-bottom: var(--space-lg);
  }

  .heritage__year {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* Timeline */
  .heritage__timeline {
    display: flex;
    justify-content: center;
    gap: 0;
    max-width: 800px;
    margin: 0 auto;
    position: relative;
  }

  .heritage__timeline::before {
    content: '';
    position: absolute;
    top: 12px;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold-600), var(--gold-500), var(--gold-600), transparent);
  }

  .heritage__milestone {
    flex: 1;
    text-align: center;
    position: relative;
    padding-top: var(--space-2xl);
  }

  .heritage__milestone-dot {
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--gold-500);
    border: 3px solid var(--burgundy-900);
    box-shadow: 0 0 0 2px var(--gold-600);
  }

  .heritage__milestone-year {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--gold-400);
    margin-bottom: 2px;
  }

  .heritage__milestone-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: var(--space-xs);
  }

  .heritage__milestone-desc {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.4;
    padding: 0 var(--space-sm);
  }

  @media (max-width: 640px) {
    .heritage__inner {
      padding: var(--space-3xl) 0;
    }

    .heritage__timeline {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-xl);
      max-width: 400px;
      width: 100%;
      margin: 0 auto;
    }

    .heritage__timeline::before {
      top: 0;
      bottom: 0;
      left: 19px;
      right: auto;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, transparent, var(--gold-600), var(--gold-500), var(--gold-600), transparent);
    }

    .heritage__milestone {
      width: 100%;
      padding-top: 0;
      padding-left: 44px;
      text-align: left;
    }

    .heritage__milestone-dot {
      top: 5px;
      left: 12px;
      transform: none;
    }

    .heritage__milestone-year {
      margin-top: -5px;
    }
  }
</style>
