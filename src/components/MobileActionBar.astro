---
import business from '../data/business.json';
import type { Language } from '../i18n/types';
import { getLanguageFromPath, getTranslations } from '../i18n/utils';

interface Props {
  lang?: Language;
}

const { lang = getLanguageFromPath(Astro.url.pathname) } = Astro.props;
const t = getTranslations(lang);
---

<div class="mobile-bar" id="mobile-action-bar">
  <a href={business.phoneLink} class="mobile-bar__btn" aria-label="Call Sanjay Cut Piece">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
    <span>{t.ctas.call}</span>
  </a>
  <a href={business.whatsappLink} target="_blank" rel="noopener noreferrer" class="mobile-bar__btn mobile-bar__btn--whatsapp" aria-label="WhatsApp Sanjay Cut Piece">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    <span>{t.ctas.whatsapp}</span>
  </a>
  <a href={business.mapsLink} target="_blank" rel="noopener noreferrer" class="mobile-bar__btn" aria-label="Get directions to Sanjay Cut Piece">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
    <span>{t.ctas.getDirections}</span>
  </a>
</div>

<style>
  .mobile-bar {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 999;
      display: flex;
      background: var(--burgundy-900);
      border-top: 2px solid var(--gold-600);
      padding: 0;
      height: var(--mobile-bar-height);
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.3);
    }
  }

  .mobile-bar__btn {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: var(--white);
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: var(--space-sm);
    transition: background var(--transition-fast);
    text-decoration: none;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-bar__btn:last-child {
    border-right: none;
  }

  .mobile-bar__btn:active {
    background: rgba(255, 255, 255, 0.1);
  }

  .mobile-bar__btn--whatsapp {
    background: #25D366;
  }

  .mobile-bar__btn--whatsapp:active {
    background: #1da851;
  }

  /* Add bottom padding to body on mobile to account for sticky bar */
  @media (max-width: 768px) {
    :global(body) {
      padding-bottom: var(--mobile-bar-height);
    }

    :global(.footer) {
      padding-bottom: var(--mobile-bar-height);
    }
  }
</style>
