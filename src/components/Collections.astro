---
import business from '../data/business.json';
import type { Language } from '../i18n/types';
import { getLanguageFromPath, getLocalizedPath, getTranslations } from '../i18n/utils';

interface Props {
  lang?: Language;
}

const { lang = getLanguageFromPath(Astro.url.pathname) } = Astro.props;
const t = getTranslations(lang);

const collections = business.collections.map(item => {
  const loc = t.collections[item.id];
  return {
    ...item,
    name: loc ? loc.name : item.name,
    description: loc ? loc.description : item.description,
    alt: loc ? loc.alt : item.alt,
  };
});
---

<section class="collections section" id="collections">
  <div class="container">
    <!-- Section Heading -->
    <div class="section-heading reveal">
      <span class="section-heading__label">{t.collectionsSection.label}</span>
      <h2 class="section-heading__title">{t.collectionsSection.title}</h2>
      <div class="gold-divider" style="margin-bottom: var(--space-md);">
        <div class="gold-divider__line"></div>
        <span class="gold-divider__ornament">❖</span>
        <div class="gold-divider__line"></div>
      </div>
      <p class="section-heading__subtitle">
        {t.collectionsSection.subtitle}
      </p>
    </div>

    <!-- Collection Grid -->
    <div class="collections__grid">
      {collections.map((item, index) => {
        const itemUrl = getLocalizedPath(`/${item.id}`, lang);
        return (
          <article class={`collection-card reveal reveal--delay-${(index % 5) + 1}`}>
            <div class="collection-card__image hover-zoom">
              <a href={itemUrl} title={`${item.name} in Thane`}>
                <img
                  src={item.image}
                  alt={item.alt}
                  loading="lazy"
                  width="400"
                  height="500"
                />
              </a>
              <div class="collection-card__overlay">
                <a
                  href={itemUrl}
                  class="btn btn--gold btn--sm"
                >
                  {t.collectionsSection.exploreCollection}
                </a>
              </div>
            </div>
            <div class="collection-card__content">
              <h3 class="collection-card__title">
                <a href={itemUrl} style="color: inherit; text-decoration: none;">{item.name}</a>
              </h3>
              <p class="collection-card__desc">{item.description}</p>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Bottom CTA -->
    <div class="collections__bottom reveal" style="text-align: center; margin-top: var(--space-3xl);">
      <p class="text-body" style="margin-bottom: var(--space-lg); color: var(--brown-600);">
        {t.collectionsSection.visitNote}
      </p>
      <div style="display: flex; justify-content: center; gap: var(--space-md); flex-wrap: wrap;">
        <a href={getLocalizedPath('/#visit', lang)} class="btn btn--primary">{t.ctas.visitStore}</a>
        <a
          href={`${business.whatsappLink}?text=Hi, I'd like to know more about your collections.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--secondary"
        >
          {t.ctas.whatsappUs}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .collections {
    background: var(--cream-200);
  }

  .collections__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .collections__grid {
      gap: var(--space-xl);
    }
  }

  @media (min-width: 768px) {
    .collections__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .collections__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-xl);
    }
  }

  /* Collection Card */
  .collection-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .collection-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .collection-card__image {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
  }

  .collection-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(74, 14, 28, 0.75) 0%, transparent 60%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--space-lg);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .collection-card:hover .collection-card__overlay {
    opacity: 1;
  }

  .collection-card__content {
    padding: var(--space-md) var(--space-md) var(--space-lg);
  }

  .collection-card__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--burgundy-900);
    margin-bottom: var(--space-xs);
    line-height: 1.3;
  }

  .collection-card__desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--brown-600);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .collection-card__content {
      padding: var(--space-sm) var(--space-sm) var(--space-md);
    }

    .collection-card__title {
      font-size: 0.9375rem;
    }

    .collection-card__desc {
      font-size: 0.75rem;
      display: none;
    }

    .collection-card__overlay {
      opacity: 1;
      background: linear-gradient(to top, rgba(74, 14, 28, 0.6) 0%, transparent 50%);
    }

    .collection-card__overlay .btn {
      font-size: 0.625rem;
      padding: 6px 12px;
      letter-spacing: 1px;
    }
  }
</style>
