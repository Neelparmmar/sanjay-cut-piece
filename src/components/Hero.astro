---
import business from '../data/business.json';
import type { Language } from '../i18n/types';
import { getLanguageFromPath, getLocalizedPath, getTranslations } from '../i18n/utils';

interface Props {
  lang?: Language;
}

const { lang = getLanguageFromPath(Astro.url.pathname) } = Astro.props;
const t = getTranslations(lang);
---

<section class="hero" id="home">
  <div class="hero__bg">
    <img
      src="/images/hero-background.png"
      alt="Premium fabric collection at Sanjay Cut Piece, Thane"
      class="hero__bg-img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content container">
    <div class="hero__text">
      <!-- Established badge -->
      <div class="hero__badge hero-entrance hero-entrance--delay-1">
        <span class="hero__badge-ornament">❖</span>
        <span class="hero__badge-text">{t.hero.since}</span>
        <span class="hero__badge-ornament">❖</span>
      </div>

      <!-- Main heading -->
      <h1 class="hero__title hero-entrance hero-entrance--delay-2">
        <span class="hero__title-main">{t.hero.brandName}</span>
        <span class="hero__title-hindi text-hindi">{t.hero.nameSubtitle}</span>
        <span class="hero__title-subtitle">{t.hero.h1Subtitle}</span>
      </h1>

      <!-- Tagline -->
      <p class="hero__tagline hero-entrance hero-entrance--delay-3">
        {t.hero.tagline}
      </p>

      <!-- Description -->
      <p class="hero__description hero-entrance hero-entrance--delay-3">
        {t.hero.description}
      </p>

      <!-- CTAs -->
      <div class="hero__actions hero-entrance hero-entrance--delay-4">
        <a href={getLocalizedPath('/#visit', lang)} class="btn btn--gold btn--lg">{t.ctas.visitStore}</a>
        <a href={business.mapsLink} target="_blank" rel="noopener noreferrer" class="btn btn--ghost-white btn--lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          {t.ctas.getDirections}
        </a>
      </div>



      <!-- Location badge -->
      <div class="hero__location hero-entrance hero-entrance--delay-5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span>{t.hero.location}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    min-height: calc(100dvh - var(--header-height));
    display: flex;
    align-items: center;
    margin-top: var(--header-height);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(74, 14, 28, 0.92) 0%,
      rgba(107, 26, 46, 0.85) 40%,
      rgba(74, 14, 28, 0.8) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding: var(--space-xl) var(--space-lg);
  }

  .hero__text {
    max-width: 700px;
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hero__badge-ornament {
    color: var(--gold-400);
    font-size: 0.75rem;
  }

  .hero__badge-text {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  /* Title */
  .hero__title {
    margin-bottom: var(--space-md);
  }

  .hero__title-main {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero__title-hindi {
    display: block;
    font-size: clamp(1rem, 2.5vw, 1.375rem);
    color: rgba(255, 255, 255, 0.7);
    margin-top: var(--space-sm);
    font-weight: 400;
  }

  .hero__title-subtitle {
    display: block;
    font-family: var(--font-body);
    font-size: clamp(0.8125rem, 1.5vw, 1rem);
    color: rgba(255, 255, 255, 0.55);
    margin-top: 6px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  /* Tagline */
  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-style: italic;
    font-weight: 400;
    color: var(--gold-400);
    line-height: 1.5;
    margin-bottom: var(--space-sm);
  }

  /* Description */
  .hero__description {
    font-family: var(--font-body);
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    max-width: 560px;
  }

  /* Actions */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  /* Secondary */
  .hero__secondary {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    transition: color var(--transition-fast);
  }

  .hero__link:hover {
    color: var(--gold-400);
  }

  .hero__link-divider {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.75rem;
  }

  /* Location */
  .hero__location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.65);
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 100px;
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      padding: var(--space-xl) 0 var(--space-2xl);
    }

    .hero__content {
      padding: var(--space-md) var(--space-md) var(--space-xl);
    }

    .hero__badge {
      margin-bottom: var(--space-xs);
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__actions .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
