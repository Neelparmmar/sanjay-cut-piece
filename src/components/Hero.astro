---
import business from '../data/business.json';
import type { Language } from '../i18n/types';
import { getLanguageFromPath, getLocalizedPath, getTranslations } from '../i18n/utils';

interface Props {
  lang?: Language;
}

const { lang = getLanguageFromPath(Astro.url.pathname) } = Astro.props;
const t = getTranslations(lang);
---

<section class="hero" id="home">
  <div class="hero__bg">
    <img
      src="/images/hero-background.png"
      alt="Premium fabric collection at Sanjay Cut Piece, Thane"
      class="hero__bg-img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content container">
    <div class="hero__text">
      <!-- Established badge -->
      <div class="hero__badge hero-entrance hero-entrance--delay-1">
        <span class="hero__badge-ornament">❖</span>
        <span class="hero__badge-text">{t.hero.since}</span>
        <span class="hero__badge-ornament">❖</span>
      </div>

      <!-- Main heading -->
      <h1 class="hero__title hero-entrance hero-entrance--delay-2">
        <span class="hero__title-main">{t.hero.brandName}</span>
        <span class="hero__title-hindi text-hindi">{t.hero.nameSubtitle}</span>
      </h1>

      <!-- Tagline -->
      <p class="hero__tagline hero-entrance hero-entrance--delay-3">
        {t.hero.tagline}
      </p>

      <!-- Description -->
      <p class="hero__description hero-entrance hero-entrance--delay-3">
        {t.hero.description}
      </p>

      <!-- CTAs -->
      <div class="hero__actions hero-entrance hero-entrance--delay-4">
        <a href={getLocalizedPath('/#visit', lang)} class="btn btn--gold btn--lg">{t.ctas.visitStore}</a>
        <a href={business.mapsLink} target="_blank" rel="noopener noreferrer" class="btn btn--ghost-white btn--lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          {t.ctas.getDirections}
        </a>
      </div>

      <!-- Secondary actions -->
      <div class="hero__secondary hero-entrance hero-entrance--delay-5">
        <a href={business.phoneLink} class="hero__link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          {t.ctas.callNow}
        </a>
        <span class="hero__link-divider">|</span>
        <a href={business.whatsappLink} target="_blank" rel="noopener noreferrer" class="hero__link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {t.ctas.whatsappUs}
        </a>
      </div>

      <!-- Location badge -->
      <div class="hero__location hero-entrance hero-entrance--delay-5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span>{t.hero.location}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    margin-top: var(--header-height);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(74, 14, 28, 0.92) 0%,
      rgba(107, 26, 46, 0.85) 40%,
      rgba(74, 14, 28, 0.8) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding: var(--space-4xl) var(--space-lg);
  }

  .hero__text {
    max-width: 700px;
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .hero__badge-ornament {
    color: var(--gold-400);
    font-size: 0.75rem;
  }

  .hero__badge-text {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  /* Title */
  .hero__title {
    margin-bottom: var(--space-lg);
  }

  .hero__title-main {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero__title-hindi {
    display: block;
    font-size: clamp(1rem, 2.5vw, 1.375rem);
    color: rgba(255, 255, 255, 0.7);
    margin-top: var(--space-sm);
    font-weight: 400;
  }

  /* Tagline */
  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-style: italic;
    font-weight: 400;
    color: var(--gold-400);
    line-height: 1.5;
    margin-bottom: var(--space-md);
  }

  /* Description */
  .hero__description {
    font-family: var(--font-body);
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
    max-width: 560px;
  }

  /* Actions */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  /* Secondary */
  .hero__secondary {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    transition: color var(--transition-fast);
  }

  .hero__link:hover {
    color: var(--gold-400);
  }

  .hero__link-divider {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.75rem;
  }

  /* Location */
  .hero__location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.65);
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 100px;
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      padding: var(--space-xl) 0 var(--space-2xl);
    }

    .hero__content {
      padding: var(--space-md) var(--space-md) var(--space-xl);
    }

    .hero__badge {
      margin-bottom: var(--space-xs);
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__actions .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
