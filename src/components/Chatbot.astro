    },
    {
      keywords: ['blouse material', 'blouse fabric'],
      response: `👚 We offer premium <strong>Blouse Materials</strong> in silk, brocade, raw silk, cotton, fancy prints and more.<br><br>Want to check availability? <a href="${WHATSAPP_LINK}?text=Hi, I'm interested in Blouse Materials" target="_blank" rel="noopener">Message on WhatsApp →</a>`,
      followUp: 'main'
    },
    {
      keywords: ['ready made blouse', 'readymade', 'stitched blouse'],
      response: `✨ Our <strong>Ready Made Blouses</strong> come in various styles for traditional, party wear and everyday occasions.<br><br>Want to see options? <a href="${WHATSAPP_LINK}?text=Hi, I'm interested in Ready Made Blouses" target="_blank" rel="noopener">Message on WhatsApp →</a>`,
      followUp: 'main'
    },
    {
      keywords: ['fabric', 'kapda', 'cloth'],
      response: `🧵 We carry a wide selection of quality <strong>Fabrics</strong> for all your creative needs and custom tailoring.<br><br>Looking for something specific? <a href="${WHATSAPP_LINK}?text=Hi, I'm looking for specific fabrics" target="_blank" rel="noopener">Tell us on WhatsApp →</a>`,
