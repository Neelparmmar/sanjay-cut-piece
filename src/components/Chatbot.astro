      followUp: 'main'
    },
    {
      keywords: ['whatsapp', 'message', 'chat', 'msg', 'wa'],
      response: `💬 You can message us directly on WhatsApp for quick assistance!<br><br><a href="${WHATSAPP_LINK}" target="_blank" rel="noopener">📱 Chat on WhatsApp →</a>`,
      followUp: 'main'
    },
    {
      keywords: ['collection', 'product', 'sell', 'available', 'what do you', 'range', 'category', 'item'],
      response: `🛍️ We have a wide range of collections:<br><br>${COLLECTIONS.map(c => `• <strong>${c.name}</strong> — ${c.description.split('.')[0]}`).join('<br>')}<br><br>Would you like to know more about any specific collection?`,
