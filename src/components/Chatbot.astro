      followUp: 'main'
    },
    {
      keywords: ['cut piece', 'cutpiece', 'cut-piece'],
      response: `✂️ We specialize in quality fabric <strong>Cut Pieces</strong> in various sizes, textures and patterns.<br><br><a href="${WHATSAPP_LINK}?text=Hi, I'm interested in Cut Pieces" target="_blank" rel="noopener">Inquire on WhatsApp →</a>`,
