      followUp: 'main'
    },
    {
      keywords: ['order', 'book', 'buy', 'purchase', 'reserve', 'delivery', 'deliver', 'ship', 'online', 'kharidna', 'lena'],
      response: `🛒 To place an order or book items, please contact us directly on WhatsApp. Our team will assist you with availability, pricing and more!<br><br><a href="${WHATSAPP_LINK}?text=Hi, I'd like to place an order" target="_blank" rel="noopener">📱 <strong>Order on WhatsApp: ${PHONE}</strong> →</a>`,
      followUp: 'main'
    },
    {
      keywords: ['payment', 'upi', 'cash', 'card', 'gpay', 'paytm', 'phonpe', 'pay'],
      response: `💳 We accept <strong>Cash</strong> and <strong>UPI</strong> payments at our store. Come visit us for a seamless shopping experience!`,
      followUp: 'main'
    },
    {
      keywords: ['history', 'since', 'year', 'old', 'established', 'heritage', 'about', 'story'],
      response: `🏛️ <strong>Sanjay Cut Piece</strong> has been serving Thane since <strong>1977</strong> — that's over 47 years of trust, quality fabrics, and traditional values. We're a well-known name at Jambli Naka, Thane West.`,
      followUp: 'main'
    },
    {
      keywords: ['thank', 'thanks', 'dhanyawad', 'shukriya', 'tq', 'thx'],
      response: `You're welcome! 🙏 If you need anything else, feel free to ask. We're always happy to help!<br><br>You can also reach us on <a href="${WHATSAPP_LINK}" target="_blank" rel="noopener">WhatsApp</a> anytime.`,
      followUp: 'main'
    },
    {
      keywords: ['bye', 'goodbye', 'see you', 'later', 'alvida'],
      response: `Goodbye! 🙏 Thank you for chatting with us. Visit us at Jambli Naka, Thane West anytime. Have a wonderful day!`,
      followUp: null
    },
  ];

  // ---- Quick Reply Menus ----
  const QUICK_REPLIES = {
    main: [
      { label: '🕐 Store Timings', message: 'What are your store timings?' },
      { label: '📍 Location', message: 'Where is your store?' },
      { label: '🛍️ Collections', message: 'What collections do you have?' },
      { label: '💰 Pricing', message: 'Tell me about pricing' },
      { label: '🛒 Place Order', message: 'I want to place an order' },
      { label: '📱 WhatsApp', message: 'I want to message on WhatsApp' },
    ],
    collections: [
      { label: '👗 Dress Materials', message: 'Tell me about dress materials' },
      { label: '👚 Blouse Materials', message: 'Tell me about blouse materials' },
      { label: '✂️ Cut Pieces', message: 'Tell me about cut pieces' },
      { label: '🧣 Dupattas', message: 'Tell me about dupattas' },
      { label: '🧵 Fabrics', message: 'Tell me about fabrics' },
      { label: '🎨 Matching Materials', message: 'Tell me about matching materials' },
      { label: '🔙 Main Menu', message: 'Hi' },
    ]
  };

  const DEFAULT_RESPONSE = `I'm not sure I understood that. You can ask me about our store timings, location, collections, or pricing.<br><br>For more detailed inquiries, please message us directly on WhatsApp:<br><a href="${WHATSAPP_LINK}?text=Hi, I need help with..." target="_blank" rel="noopener">📱 <strong>WhatsApp: ${PHONE}</strong> →</a>`;

  // ---- DOM Elements ----
  const toggle = document.getElementById('chatbot-toggle');
  const badge = document.getElementById('chatbot-badge');
  const logoIcon = document.getElementById('chatbot-toggle-logo');
  const closeIcon = document.getElementById('chatbot-toggle-close');
  const chatWindow = document.getElementById('chatbot-window');
  const closeBtn = document.getElementById('chatbot-close');
  const messagesEl = document.getElementById('chatbot-messages');
  const quickRepliesEl = document.getElementById('chatbot-quick-replies');
  const inputEl = document.getElementById('chatbot-input');
  const sendBtn = document.getElementById('chatbot-send');

  let isOpen = false;
  let hasGreeted = false;

  // ---- Toggle Chat ----
  function openChat() {
    isOpen = true;
    chatWindow.classList.add('open');
    chatWindow.setAttribute('aria-hidden', 'false');
    logoIcon.style.display = 'none';
    closeIcon.style.display = 'block';
    badge.classList.add('hidden');
    toggle.style.animation = 'none';

    if (!hasGreeted) {
      hasGreeted = true;
      showTypingThenReply(
        `Namaste! 🙏 Welcome to <strong>Sanjay Cut Piece</strong>.<br>I can help you with store info, collections, pricing & more.<br><br>How can I assist you today?`,
        'main'
      );
    }

    setTimeout(() => inputEl.focus(), 400);
  }

  function closeChat() {
    isOpen = false;
    chatWindow.classList.remove('open');
    chatWindow.setAttribute('aria-hidden', 'true');
    logoIcon.style.display = 'block';
    closeIcon.style.display = 'none';
  }

  toggle.addEventListener('click', () => {
    if (isOpen) closeChat();
    else openChat();
  });

  closeBtn.addEventListener('click', closeChat);

  // ---- Message Rendering ----
  function addMessage(text, sender) {
    const div = document.createElement('div');
    div.className = `chatbot-msg chatbot-msg--${sender}`;
    div.innerHTML = text;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function showTyping() {
    const div = document.createElement('div');
    div.className = 'chatbot-typing';
    div.id = 'chatbot-typing-indicator';
    div.innerHTML = '<span></span><span></span><span></span>';
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function removeTyping() {
    const el = document.getElementById('chatbot-typing-indicator');
    if (el) el.remove();
  }

  function showTypingThenReply(text, quickReplyMenu) {
    showTyping();
    const delay = 600 + Math.random() * 500;
    setTimeout(() => {
      removeTyping();
      addMessage(text, 'bot');
      if (quickReplyMenu && QUICK_REPLIES[quickReplyMenu]) {
        renderQuickReplies(quickReplyMenu);
      }
    }, delay);
  }

  // ---- Quick Replies ----
  function renderQuickReplies(menuKey) {
    quickRepliesEl.innerHTML = '';
    const items = QUICK_REPLIES[menuKey] || [];
    items.forEach(item => {
      const btn = document.createElement('button');
      btn.className = 'chatbot-qr';
      btn.textContent = item.label;
      btn.addEventListener('click', () => {
        handleUserMessage(item.message);
      });
      quickRepliesEl.appendChild(btn);
    });
  }

  // ---- Message Processing ----
  function findResponse(input) {
    const lower = input.toLowerCase().trim();
    for (const rule of FAQ_RULES) {
      for (const kw of rule.keywords) {
        if (lower.includes(kw)) {
          return { response: rule.response, followUp: rule.followUp };
        }
      }
    }
    return { response: DEFAULT_RESPONSE, followUp: 'main' };
  }

  function handleUserMessage(text) {
    if (!text.trim()) return;
    addMessage(text, 'user');
    quickRepliesEl.innerHTML = '';
    inputEl.value = '';

    const { response, followUp } = findResponse(text);
    showTypingThenReply(response, followUp);
  }

  // ---- Input Events ----
  sendBtn.addEventListener('click', () => {
    handleUserMessage(inputEl.value);
  });

  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleUserMessage(inputEl.value);
    }
  });

  // ---- Close on Escape ----
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      closeChat();
    }
  });
</script>
