---
import business from '../data/business.json';
---

<!-- Chatbot Toggle Button -->
<button class="chatbot-toggle" id="chatbot-toggle" aria-label="Open chat assistant">
  <img
    src="/images/chatbot-icon.jpg"
    alt="Sanjay Cut Piece Chat"
    class="chatbot-toggle__logo"
    id="chatbot-toggle-logo"
  />
  <svg class="chatbot-toggle__close" id="chatbot-toggle-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
    <line x1="18" y1="6" x2="6" y2="18"></line>
    <line x1="6" y1="6" x2="18" y2="18"></line>
  </svg>
  <!-- Notification dot -->
  <span class="chatbot-toggle__badge" id="chatbot-badge"></span>
</button>

<!-- Chatbot Window -->
<div class="chatbot" id="chatbot-window" aria-hidden="true">
  <!-- Header -->
  <div class="chatbot__header">
    <div class="chatbot__header-info">
      <img src="/images/SC_logo_round_HD_tight.png" alt="Sanjay Cut Piece" class="chatbot__avatar" />
      <div>
        <div class="chatbot__header-name">Sanjay Cut Piece</div>
        <div class="chatbot__header-status">
          <span class="chatbot__status-dot"></span>
          Online — We typically reply instantly
        </div>
      </div>
    </div>
    <button class="chatbot__close-btn" id="chatbot-close" aria-label="Close chat">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Messages -->
  <div class="chatbot__messages" id="chatbot-messages">
    <!-- Messages will be injected here -->
  </div>

  <!-- Quick Replies -->
  <div class="chatbot__quick-replies" id="chatbot-quick-replies">
    <!-- Quick reply buttons injected here -->
  </div>

  <!-- Input -->
  <div class="chatbot__input-area">
    <input
      type="text"
      class="chatbot__input"
      id="chatbot-input"
      placeholder="Type your message..."
      autocomplete="off"
    />
    <button class="chatbot__send" id="chatbot-send" aria-label="Send message">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
      </svg>
    </button>
  </div>
</div>

<style>
  /* ---- CHATBOT TOGGLE BUTTON ---- */
  .chatbot-toggle {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 10000;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 3px solid var(--gold-500);
    background: var(--burgundy-900);
    box-shadow: 0 6px 28px rgba(74, 14, 28, 0.45), 0 0 0 0 rgba(197, 165, 90, 0.4);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(.4,2,.6,1), box-shadow 0.3s ease;
    animation: chatbot-pulse 3s ease-in-out infinite;
    overflow: hidden;
    padding: 0;
  }

  .chatbot-toggle:hover {
    transform: scale(1.1);
    box-shadow: 0 8px 32px rgba(74, 14, 28, 0.5), 0 0 0 6px rgba(197, 165, 90, 0.15);
  }

  .chatbot-toggle__logo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    transition: opacity 0.25s ease, transform 0.3s ease;
  }

  .chatbot-toggle__close {
    color: var(--white);
    transition: opacity 0.25s ease, transform 0.3s ease;
    position: absolute;
  }

  .chatbot-toggle__badge {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 14px;
    height: 14px;
    background: #25D366;
    border-radius: 50%;
    border: 2px solid var(--burgundy-900);
    animation: badge-pulse 2s ease-in-out infinite;
  }

  .chatbot-toggle__badge.hidden {
    display: none;
  }

  @keyframes chatbot-pulse {
    0%, 100% { box-shadow: 0 6px 28px rgba(74, 14, 28, 0.45), 0 0 0 0 rgba(197, 165, 90, 0.4); }
    50% { box-shadow: 0 6px 28px rgba(74, 14, 28, 0.45), 0 0 0 8px rgba(197, 165, 90, 0); }
  }

  @keyframes badge-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.3); }
  }

  /* ---- CHATBOT WINDOW ---- */
  .chatbot {
    position: fixed;
    bottom: 100px;
    right: 24px;
    z-index: 9999;
    width: 380px;
    max-height: 540px;
    background: var(--white);
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(44, 24, 16, 0.25), 0 0 0 1px rgba(44, 24, 16, 0.06);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.95);
    transform-origin: bottom right;
    transition: opacity 0.35s cubic-bezier(.4,0,.2,1),
                transform 0.35s cubic-bezier(.4,0,.2,1),
                visibility 0.35s;
  }

  .chatbot.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* ---- HEADER ---- */
  .chatbot__header {
    background: linear-gradient(135deg, var(--burgundy-900), var(--burgundy-700));
    color: var(--white);
    padding: 16px 16px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-shrink: 0;
  }

  .chatbot__header-info {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .chatbot__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 2px solid var(--gold-500);
    object-fit: cover;
    flex-shrink: 0;
  }

  .chatbot__header-name {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
    white-space: nowrap;
  }

  .chatbot__header-status {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    opacity: 0.85;
    margin-top: 2px;
    white-space: nowrap;
  }

  .chatbot__status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #25D366;
    flex-shrink: 0;
    animation: status-glow 2s ease-in-out infinite;
  }

  @keyframes status-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
    50% { box-shadow: 0 0 0 4px rgba(37, 211, 102, 0); }
  }

  .chatbot__close-btn {
    background: rgba(255,255,255,0.12);
    border: none;
    border-radius: 50%;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--white);
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .chatbot__close-btn:hover {
    background: rgba(255,255,255,0.22);
  }

  /* ---- MESSAGES ---- */
  .chatbot__messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: linear-gradient(180deg, #faf7f2 0%, var(--white) 100%);
    min-height: 200px;
    max-height: 300px;
  }

  .chatbot__messages::-webkit-scrollbar {
    width: 4px;
  }

  .chatbot__messages::-webkit-scrollbar-track {
    background: transparent;
  }

  .chatbot__messages::-webkit-scrollbar-thumb {
    background: var(--cream-400);
    border-radius: 4px;
  }

  /* Message Bubbles */
  :global(.chatbot-msg) {
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 16px;
    font-size: 13.5px;
    line-height: 1.55;
    font-family: 'Inter', sans-serif;
    animation: msg-in 0.35s cubic-bezier(.4,0,.2,1);
    word-break: break-word;
  }

  @keyframes msg-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.chatbot-msg--bot) {
    align-self: flex-start;
    background: var(--cream-200);
    color: var(--brown-900);
    border-bottom-left-radius: 4px;
  }

  :global(.chatbot-msg--user) {
    align-self: flex-end;
    background: linear-gradient(135deg, var(--burgundy-800), var(--burgundy-700));
    color: var(--white);
    border-bottom-right-radius: 4px;
  }

  :global(.chatbot-msg--bot a) {
    color: var(--burgundy-700);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--gold-500);
    text-underline-offset: 2px;
  }

  :global(.chatbot-msg--bot a:hover) {
    color: var(--burgundy-900);
  }

  /* Typing indicator */
  :global(.chatbot-typing) {
    display: flex;
    gap: 4px;
    padding: 12px 16px;
    align-self: flex-start;
    background: var(--cream-200);
    border-radius: 16px;
    border-bottom-left-radius: 4px;
  }

  :global(.chatbot-typing span) {
    width: 7px;
    height: 7px;
    background: var(--brown-500);
    border-radius: 50%;
    animation: typing-bounce 1.4s ease-in-out infinite;
  }

  :global(.chatbot-typing span:nth-child(2)) { animation-delay: 0.2s; }
  :global(.chatbot-typing span:nth-child(3)) { animation-delay: 0.4s; }

  @keyframes typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-6px); opacity: 1; }
  }

  /* ---- QUICK REPLIES ---- */
  .chatbot__quick-replies {
    padding: 6px 16px 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    background: var(--white);
    border-top: 1px solid var(--cream-300);
    flex-shrink: 0;
  }

  .chatbot__quick-replies:empty {
    display: none;
    padding: 0;
    border: none;
  }

  :global(.chatbot-qr) {
    padding: 7px 14px;
    border-radius: 20px;
    border: 1.5px solid var(--burgundy-700);
    background: transparent;
    color: var(--burgundy-700);
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  :global(.chatbot-qr:hover) {
    background: var(--burgundy-700);
    color: var(--white);
    transform: translateY(-1px);
  }

  /* ---- INPUT AREA ---- */
  .chatbot__input-area {
    padding: 12px 12px 14px;
    display: flex;
    gap: 8px;
    align-items: center;
    background: var(--white);
    border-top: 1px solid var(--cream-300);
    flex-shrink: 0;
  }

  .chatbot__input {
    flex: 1;
    border: 1.5px solid var(--cream-400);
    border-radius: 24px;
    padding: 10px 16px;
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    color: var(--brown-900);
    background: var(--cream-100);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .chatbot__input:focus {
    border-color: var(--burgundy-600);
    box-shadow: 0 0 0 3px rgba(107, 26, 46, 0.08);
  }

  .chatbot__input::placeholder {
    color: var(--brown-500);
    opacity: 0.7;
  }

  .chatbot__send {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--burgundy-800), var(--burgundy-700));
    color: var(--white);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    flex-shrink: 0;
  }

  .chatbot__send:hover {
    transform: scale(1.08);
    box-shadow: 0 4px 12px rgba(74, 14, 28, 0.3);
  }

  .chatbot__send:active {
    transform: scale(0.95);
  }

  /* ---- MOBILE RESPONSIVE ---- */
  @media (max-width: 768px) {
    .chatbot-toggle {
      bottom: 76px; /* above mobile action bar */
      right: 16px;
      width: 56px;
      height: 56px;
    }

    .chatbot-toggle__logo {
      width: 38px;
      height: 38px;
    }

    .chatbot {
      bottom: 0;
      right: 0;
      left: 0;
      width: 100%;
      max-height: 85vh;
      border-radius: 20px 20px 0 0;
      transform-origin: bottom center;
    }

    .chatbot__messages {
      max-height: 50vh;
    }
  }
</style>

<script define:vars={{ business }}>
  // ============================================
  // SANJAY CUT PIECE — CHATBOT ENGINE
  // Rule-based FAQ chatbot with WhatsApp handoff
  // ============================================

  const WHATSAPP_LINK = business.whatsappLink;
  const PHONE = business.phoneFormatted;
  const PHONE_LINK = business.phoneLink;
  const HOURS = business.hours;
  const ADDRESS = business.address;
  const MAPS_LINK = business.mapsLink;
  const COLLECTIONS = business.collections;

  // ---- FAQ Knowledge Base ----
  const FAQ_RULES = [
