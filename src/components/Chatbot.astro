  };

  // ---- DOM Elements ----
  const toggle = document.getElementById('chatbot-toggle');
  const badge = document.getElementById('chatbot-badge');
  const logoIcon = document.getElementById('chatbot-toggle-logo');
  const closeIcon = document.getElementById('chatbot-toggle-close');
  const chatWindow = document.getElementById('chatbot-window');
  const closeBtn = document.getElementById('chatbot-close');
  const backBtn = document.getElementById('chatbot-back');
  const resetBtn = document.getElementById('chatbot-reset');
  const messagesEl = document.getElementById('chatbot-messages');
  const quickRepliesEl = document.getElementById('chatbot-quick-replies');
  const inputEl = document.getElementById('chatbot-input');
  const sendBtn = document.getElementById('chatbot-send');
  const headerStatusEl = document.querySelector('.chatbot__header-status');

  const STORAGE_MSGS = 'scp_chat_messages_v2';
  const STORAGE_LANG = 'scp_chat_lang_v2';
  const STORAGE_MENU = 'scp_chat_menu_v2';

  let isOpen = false;
  let hasGreeted = false;
  let menuStack = [];
  let currentMenuKey = null;

  // ---- Menu Navigation & Back Buttons ----
  function updateNavButtons() {
    if (!backBtn) return;
    const canGoBack = menuStack.length > 0 || (currentLang !== null && currentMenuKey !== 'langSelect');
    backBtn.style.display = canGoBack ? 'flex' : 'none';
  }

  function goBack() {
    if (menuStack.length > 0) {
      const prev = menuStack.pop();
      renderQuickReplies(prev, false);
    } else if (currentLang && currentMenuKey !== 'langSelect') {
      menuStack = [];
      renderQuickReplies('langSelect', false);
    }
    updateNavButtons();
  }

  // ---- History & Storage Management ----
  function saveMessageToStorage(text, sender) {
    try {
      const history = JSON.parse(sessionStorage.getItem(STORAGE_MSGS) || '[]');
      history.push({ text, sender, time: Date.now() });
      sessionStorage.setItem(STORAGE_MSGS, JSON.stringify(history));
      if (currentLang) {
        sessionStorage.setItem(STORAGE_LANG, currentLang);
      }
    } catch (e) {}
  }

  function restoreHistory() {
    try {
      const savedMsgs = JSON.parse(sessionStorage.getItem(STORAGE_MSGS) || '[]');
      const savedLang = sessionStorage.getItem(STORAGE_LANG);
      const savedMenu = sessionStorage.getItem(STORAGE_MENU);

      if (savedMsgs && savedMsgs.length > 0) {
        hasGreeted = true;
        if (savedLang && LANG_DATA[savedLang]) {
          currentLang = savedLang;
          applyLanguageUI(savedLang);
        }

        const div = document.createElement('div');
        div.className = 'chatbot-history-divider';
        div.innerHTML = '<span>Past Conversation</span>';
        messagesEl.appendChild(div);

        savedMsgs.forEach(msg => {
          addMessage(msg.text, msg.sender, false);
        });

        const targetMenu = savedMenu || 'main';
        renderQuickReplies(targetMenu, false);
        return true;
      }
    } catch (e) {}
    return false;
  }

  function resetChat() {
    try {
      sessionStorage.removeItem(STORAGE_MSGS);
      sessionStorage.removeItem(STORAGE_LANG);
      sessionStorage.removeItem(STORAGE_MENU);
    } catch (e) {}

    messagesEl.innerHTML = '';
    quickRepliesEl.innerHTML = '';
    currentLang = null;
    menuStack = [];
    currentMenuKey = null;
    hasGreeted = false;
    updateNavButtons();

    inputEl.placeholder = LANG_DATA.en.inputPlaceholder;
    if (headerStatusEl) {
      const dot = headerStatusEl.querySelector('.chatbot__status-dot');
      headerStatusEl.textContent = '';
      if (dot) headerStatusEl.appendChild(dot);
      headerStatusEl.appendChild(document.createTextNode(' ' + LANG_DATA.en.headerStatus));
    }

    showTypingThenReply(
      `🙏 Welcome to <strong>Sanjay Cut Piece</strong>!<br><br>Please select your preferred language:<br>कृपया अपनी भाषा चुनें:<br>कृपया तुमची भाषा निवडा:`,
      'langSelect'
    );
  }

  // ---- Toggle Chat ----
  function openChat() {
    isOpen = true;
    chatWindow.classList.add('open');
    chatWindow.setAttribute('aria-hidden', 'false');
    logoIcon.style.display = 'none';
    closeIcon.style.display = 'block';
    badge.classList.add('hidden');
    toggle.style.animation = 'none';

    if (!hasGreeted) {
      const restored = restoreHistory();
      if (!restored) {
        hasGreeted = true;
        // Show language selection first
        showTypingThenReply(
          `🙏 Welcome to <strong>Sanjay Cut Piece</strong>!<br><br>Please select your preferred language:<br>कृपया अपनी भाषा चुनें:<br>कृपया तुमची भाषा निवडा:`,
          'langSelect'
        );
      }
    }

    setTimeout(() => inputEl.focus(), 400);
  }

  function closeChat() {
    isOpen = false;
    chatWindow.classList.remove('open');
    chatWindow.setAttribute('aria-hidden', 'true');
    logoIcon.style.display = 'block';
    closeIcon.style.display = 'none';
  }

  toggle.addEventListener('click', () => {
    if (isOpen) closeChat();
    else openChat();
  });

  closeBtn.addEventListener('click', closeChat);
  if (backBtn) backBtn.addEventListener('click', goBack);
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (confirm('Start a new conversation? / नई बातचीत शुरू करें?')) {
        resetChat();
      }
    });
  }

  // ---- Message Rendering ----
  function addMessage(text, sender, save = true) {
    const div = document.createElement('div');
    div.className = `chatbot-msg chatbot-msg--${sender}`;
    div.innerHTML = text;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;

    if (save) {
      saveMessageToStorage(text, sender);
    }
  }

  function showTyping() {
    const div = document.createElement('div');
    div.className = 'chatbot-typing';
    div.id = 'chatbot-typing-indicator';
    div.innerHTML = '<span></span><span></span><span></span>';
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function removeTyping() {
    const el = document.getElementById('chatbot-typing-indicator');
    if (el) el.remove();
  }

  function showTypingThenReply(text, quickReplyMenu) {
    showTyping();
    const delay = 500 + Math.random() * 400;
    setTimeout(() => {
      removeTyping();
      addMessage(text, 'bot');
      if (quickReplyMenu) {
        renderQuickReplies(quickReplyMenu);
      }
    }, delay);
  }

  // ---- Quick Replies ----
  function renderQuickReplies(menuKey, pushToStack = true) {
    if (pushToStack && currentMenuKey && currentMenuKey !== menuKey) {
      menuStack.push(currentMenuKey);
    }
    currentMenuKey = menuKey;
    try {
      sessionStorage.setItem(STORAGE_MENU, menuKey);
    } catch (e) {}
    updateNavButtons();

    quickRepliesEl.innerHTML = '';

    // Special: language selection menu
    if (menuKey === 'langSelect') {
      const langOptions = [
        { label: '🇬🇧 English', lang: 'en' },
        { label: '🇮🇳 हिन्दी', lang: 'hi' },
        { label: '🇮🇳 मराठी', lang: 'mr' },
      ];
      langOptions.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = 'chatbot-qr';
        btn.textContent = opt.label;
        btn.addEventListener('click', () => selectLanguage(opt.lang));
        quickRepliesEl.appendChild(btn);
      });
      return;
    }

    // Normal quick replies from current language
    if (!currentLang) return;
    const langData = LANG_DATA[currentLang];
    const items = (langData.quickReplies && langData.quickReplies[menuKey]) || [];
    items.forEach(item => {
      const btn = document.createElement('button');
      btn.className = 'chatbot-qr' + (item.isBack ? ' chatbot-qr--back' : '');
      btn.textContent = item.label;
      btn.addEventListener('click', () => {
        if (item.action === 'back') {
          goBack();
        } else if (item.action === 'changeLang') {
          renderQuickReplies('langSelect', true);
        } else {
          handleUserMessage(item.message);
        }
      });
      quickRepliesEl.appendChild(btn);
    });
  }

  function applyLanguageUI(lang) {
    const langData = LANG_DATA[lang];
    if (!langData) return;
    inputEl.placeholder = langData.inputPlaceholder;
    if (headerStatusEl) {
      const dot = headerStatusEl.querySelector('.chatbot__status-dot');
      headerStatusEl.textContent = '';
      if (dot) headerStatusEl.appendChild(dot);
      headerStatusEl.appendChild(document.createTextNode(' ' + langData.headerStatus));
    }
  }

  // ---- Language Selection ----
  function selectLanguage(lang) {
    currentLang = lang;
    try {
      sessionStorage.setItem(STORAGE_LANG, lang);
    } catch (e) {}

    const langData = LANG_DATA[lang];

    // Show user's selection
    addMessage(langData.name, 'user');
    quickRepliesEl.innerHTML = '';

    applyLanguageUI(lang);
    menuStack = [];
    // Greet in chosen language
    showTypingThenReply(langData.greetAfterLang, 'main');
  }

  // ---- Message Processing ----
  function findResponse(input) {
    if (!currentLang) {
      // If language not yet selected, check for language hints
      const lower = input.toLowerCase().trim();
      if (lower.includes('english') || lower.includes('eng')) {
        return { action: 'selectLang', lang: 'en' };
      }
      if (lower.includes('hindi') || lower.includes('हिन्दी') || lower.includes('हिंदी')) {
        return { action: 'selectLang', lang: 'hi' };
      }
      if (lower.includes('marathi') || lower.includes('मराठी')) {
        return { action: 'selectLang', lang: 'mr' };
      }
      return {
        action: 'reply',
        response: `Please select a language first / कृपया पहले भाषा चुनें:`,
        followUp: 'langSelect'
      };
    }

    const langData = LANG_DATA[currentLang];
    const lower = input.toLowerCase().trim();

    for (const rule of langData.faq) {
      for (const kw of rule.keywords) {
        if (lower.includes(kw)) {
          return { action: 'reply', response: rule.response, followUp: rule.followUp };
        }
      }
    }
    return { action: 'reply', response: langData.defaultResponse, followUp: 'main' };
  }

  function handleUserMessage(text) {
    if (!text.trim()) return;
    addMessage(text, 'user');
    quickRepliesEl.innerHTML = '';
    inputEl.value = '';

    const result = findResponse(text);

    if (result.action === 'selectLang') {
      selectLanguage(result.lang);
    } else {
      showTypingThenReply(result.response, result.followUp);
    }
  }

  // ---- Input Events ----
  sendBtn.addEventListener('click', () => {
    handleUserMessage(inputEl.value);
  });

  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleUserMessage(inputEl.value);
    }
  });

  // ---- Close on Escape ----
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      closeChat();
    }
  });
</script>

