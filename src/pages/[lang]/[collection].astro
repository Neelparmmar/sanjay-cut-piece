---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import business from '../../data/business.json';
import type { Language } from '../../i18n/types';
import { getLocalizedPath, getLocalizedSeo, getTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  const languages: Language[] = ['hi', 'mr', 'gu'];
  const paths: any[] = [];
  for (const lang of languages) {
    for (const item of business.collections) {
      paths.push({
        params: { lang, collection: item.id },
        props: { collectionItem: item, lang }
      });
    }
  }
  return paths;
}

const { collection, lang: langParam } = Astro.params;
const { collectionItem, lang: propLang } = Astro.props;

const lang: Language = (langParam || propLang || 'en') as Language;
const t = getTranslations(lang);

const urlPath = `/${collection}`;
const pageSeo = getLocalizedSeo(urlPath, lang);
const locCollection = t.collections[collectionItem.id] || collectionItem;

// Other related collections for internal linking
const relatedCollections = business.collections
  .filter(c => c.id !== collection)
  .map(c => {
    const loc = t.collections[c.id];
    return {
      ...c,
      name: loc ? loc.name : c.name,
      description: loc ? loc.description : c.description,
      alt: loc ? loc.alt : c.alt,
    };
  });
---

<Layout
  title={pageSeo.title}
  description={pageSeo.description}
  keywords={[pageSeo.primaryKeyword, ...pageSeo.secondaryKeywords, ...pageSeo.longTailKeywords]}
  ogImage={collectionItem.image}
  schemaType={pageSeo.schemaType}
  breadcrumbs={pageSeo.breadcrumbs}
  lang={lang}
>
  <Header lang={lang} />
  
  <main class="collection-landing">
    <!-- Breadcrumbs Section -->
    <nav class="breadcrumbs-container container" aria-label="Breadcrumb">
      <ol class="breadcrumbs-list">
        {pageSeo.breadcrumbs.map((crumb, idx) => (
          <li class="breadcrumb-item">
            {idx > 0 && <span class="breadcrumb-separator">/</span>}
            {idx === pageSeo.breadcrumbs.length - 1 ? (
              <span class="breadcrumb-current" aria-current="page">{crumb.name}</span>
            ) : (
              <a href={crumb.item} class="breadcrumb-link">{crumb.name}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Hero Header -->
    <section class="landing-hero section--compact">
      <div class="container">
        <div class="landing-hero__content text-center">
          <span class="landing-hero__badge">{t.collectionDetail.badge}</span>
          <h1 class="landing-hero__title">{pageSeo.h1}</h1>
          <p class="landing-hero__subtitle">{pageSeo.description}</p>
          <div class="gold-divider" style="margin: 1.5rem auto;">
            <div class="gold-divider__line"></div>
            <span class="gold-divider__ornament">❖</span>
            <div class="gold-divider__line"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Detail Section -->
    <section class="landing-main section">
      <div class="container">
        <div class="landing-grid">
          <!-- Image Column -->
          <div class="landing-image-col">
            <div class="landing-image-card">
              <img
                src={collectionItem.image}
                alt={locCollection.alt}
                width="600"
                height="750"
                loading="eager"
                class="landing-img"
              />
              <div class="landing-image-badge">
                <span>📍 Jambli Naka, Thane West</span>
              </div>
            </div>
          </div>

          <!-- Description & Keyword Content Column -->
          <div class="landing-text-col">
            <h2 class="landing-section-heading">{t.collectionDetail.whyChooseTitle} {locCollection.name}?</h2>
            <p class="landing-text-lead">
              {t.collectionDetail.leadTextPrefix} <strong>Sanjay Cut Piece & Matching Centre</strong> {t.collectionDetail.leadTextSuffix.replace('{collection}', locCollection.name.toLowerCase())}
            </p>

            <div class="features-list">
              {t.collectionDetail.features.map((feat, i) => (
                <div class="feature-item">
                  <span class="feature-number">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{feat.title}</h3>
                    <p>{feat.desc}</p>
                  </div>
                </div>
              ))}
            </div>


          </div>
        </div>
      </div>
    </section>

    <!-- Cinematic Slideshow Section -->
    <section class="cinematic" aria-label="Fabric showcase">
      <div class="cinematic__slides">
        <div class="cinematic__slide cinematic__slide--1"></div>
        <div class="cinematic__slide cinematic__slide--2"></div>
        <div class="cinematic__slide cinematic__slide--3"></div>
        <div class="cinematic__slide cinematic__slide--4"></div>
        <div class="cinematic__slide cinematic__slide--5"></div>
      </div>
      <div class="cinematic__overlay"></div>
      <div class="cinematic__content">
        <span class="cinematic__label">Our Collection</span>
        <h2 class="cinematic__title">{locCollection.name}</h2>
        <div class="cinematic__line"></div>
        <p class="cinematic__tagline">Traditional • Trendy • Timeless</p>
      </div>
    </section>

    <!-- Internal Linking Section: Explore Other Landing Pages -->
    <section class="landing-related section" style="background: var(--cream-200);">
      <div class="container">
        <div class="section-heading reveal">
          <span class="section-heading__label">{t.collectionDetail.relatedLabel}</span>
          <h2 class="section-heading__title">{t.collectionDetail.relatedTitle}</h2>
          <div class="gold-divider" style="margin-bottom: var(--space-md);">
            <div class="gold-divider__line"></div>
            <span class="gold-divider__ornament">❖</span>
            <div class="gold-divider__line"></div>
          </div>
        </div>

        <div class="related-grid">
          {relatedCollections.slice(0, 4).map((rel) => {
            const relUrl = getLocalizedPath(`/${rel.id}`, lang);
            return (
              <a href={relUrl} class="related-card">
                <div class="related-card__img-wrap">
                  <img src={rel.image} alt={rel.alt} width="300" height="200" loading="lazy" />
                </div>
                <div class="related-card__body">
                  <h3 class="related-card__title">{rel.name}</h3>
                  <p class="related-card__desc">{rel.description}</p>
                  <span class="related-card__link-text">{t.collectionDetail.exploreRelated} {rel.name} &rarr;</span>
                </div>
              </a>
            );
          })}
        </div>
        
        <div class="text-center" style="margin-top: 2rem;">
          <a href={getLocalizedPath('/sitemap.html', lang)} class="btn btn--secondary btn--sm">{t.collectionDetail.sitemapBtn}</a>
        </div>
      </div>
    </section>

    <!-- Store Location CTA -->
    <section class="landing-store section">
      <div class="container text-center">
        <h2 class="section-heading__title">{t.collectionDetail.visitTitle}</h2>
        <p class="text-body-lg" style="max-width: 600px; margin: 1rem auto; color: var(--brown-700);">
          {business.address.full}
        </p>
        <p class="text-body" style="color: var(--brown-600); margin-bottom: 1.5rem;">
          {t.collectionDetail.openDaily} <strong>{business.hours.display}</strong> ({business.hours.days})
        </p>
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href={business.directionsLink} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            📍 {t.ctas.getDirections}
          </a>
          <a href={getLocalizedPath('/#collections', lang)} class="btn btn--secondary">
            {t.ctas.viewAllCategories}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
  <MobileActionBar lang={lang} />
</Layout>

<style>
  .collection-landing {
    padding-top: 80px;
    background-color: var(--white);
  }

  .breadcrumbs-container {
    padding-top: var(--space-md);
    padding-bottom: var(--space-xs);
  }

  .breadcrumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--brown-600);
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
  }

  .breadcrumb-separator {
    margin: 0 0.5rem;
    color: var(--brown-400);
  }

  .breadcrumb-link {
    color: var(--burgundy-800);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: var(--gold-600);
    text-decoration: underline;
  }

  .breadcrumb-current {
    color: var(--brown-600);
    font-weight: 500;
  }

  .landing-hero {
    background: linear-gradient(135deg, var(--burgundy-900) 0%, #2A0810 100%);
    color: var(--white);
    padding: 3rem 1rem;
    margin-top: 1rem;
  }

  .landing-hero__badge {
    display: inline-block;
    background: rgba(212, 163, 89, 0.2);
    color: var(--gold-400);
    border: 1px solid var(--gold-500);
    padding: 0.35rem 1rem;
    border-radius: 50px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .landing-hero__title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    color: var(--gold-300);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .landing-hero__subtitle {
    font-size: 1.125rem;
    color: var(--cream-200);
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .landing-main {
    padding: 3rem 0;
  }

  .landing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .landing-grid {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
    }
  }

  .landing-image-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--cream-300);
  }

  .landing-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .landing-image-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(74, 14, 28, 0.9);
    color: var(--gold-300);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    text-align: center;
    font-weight: 500;
    backdrop-filter: blur(4px);
  }

  .landing-section-heading {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--burgundy-900);
    margin-bottom: 1rem;
  }

  .landing-text-lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--brown-800);
    margin-bottom: 1.5rem;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .feature-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--cream-300);
  }

  .feature-item:last-child {
    border-bottom: none;
  }

  .feature-number {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--gold-500);
    line-height: 1;
    min-width: 2rem;
    padding-top: 0.15rem;
  }

  .feature-item h3 {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--burgundy-900);
    margin-bottom: 0.25rem;
  }

  .feature-item p {
    font-size: 0.875rem;
    color: var(--brown-600);
    line-height: 1.5;
    margin: 0;
  }

  .keyword-box {
    background: var(--white);
    border: 1px solid var(--gold-300);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-top: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .keyword-box__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--burgundy-900);
    margin-bottom: 0.5rem;
  }

  .keyword-box p {
    font-size: 0.9375rem;
    color: var(--brown-700);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .landing-cta-group {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .related-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .related-card {
    background: var(--white);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .related-card__img-wrap {
    height: 140px;
    overflow: hidden;
  }

  .related-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-card__body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .related-card__title {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--burgundy-900);
    margin-bottom: 0.35rem;
  }

  .related-card__desc {
    font-size: 0.8125rem;
    color: var(--brown-600);
    line-height: 1.4;
    margin-bottom: 0.75rem;
    flex-grow: 1;
  }

  .related-card__link-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--gold-600);
  }

  .text-center {
    text-align: center;
  }

  /* ---- Cinematic Slideshow ---- */
  .cinematic {
    position: relative;
    width: 100%;
    height: 60vh;
    min-height: 360px;
    max-height: 500px;
    overflow: hidden;
  }

  .cinematic__slides {
    position: absolute;
    inset: 0;
  }

  .cinematic__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    animation: cineFade 25s infinite;
    will-change: opacity, transform;
  }

  .cinematic__slide--1 {
    background-image: url('/images/hero-background.png');
    animation-delay: 0s;
    animation-name: cineFade, cineZoom1;
  }
  .cinematic__slide--2 {
    background-image: url('/images/dress-materials.png');
    animation-delay: 5s;
    animation-name: cineFade, cineZoom2;
  }
  .cinematic__slide--3 {
    background-image: url('/images/blouse-materials.png');
    animation-delay: 10s;
    animation-name: cineFade, cineZoom1;
  }
  .cinematic__slide--4 {
    background-image: url('/images/dupattas.png');
    animation-delay: 15s;
    animation-name: cineFade, cineZoom2;
  }
  .cinematic__slide--5 {
    background-image: url('/images/matching-materials.png');
    animation-delay: 20s;
    animation-name: cineFade, cineZoom1;
  }

  @keyframes cineFade {
    0%     { opacity: 0; }
    4%     { opacity: 1; }
    20%    { opacity: 1; }
    24%    { opacity: 0; }
    100%   { opacity: 0; }
  }

  @keyframes cineZoom1 {
    0%     { transform: scale(1); }
    20%    { transform: scale(1.08); }
    100%   { transform: scale(1.08); }
  }

  @keyframes cineZoom2 {
    0%     { transform: scale(1.06); }
    20%    { transform: scale(1); }
    100%   { transform: scale(1); }
  }

  .cinematic__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(74, 14, 28, 0.5) 0%,
      rgba(74, 14, 28, 0.75) 50%,
      rgba(42, 8, 16, 0.85) 100%
    );
    z-index: 1;
  }

  .cinematic__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: 2rem;
  }

  .cinematic__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold-400);
    margin-bottom: 0.75rem;
    opacity: 0;
    animation: cineFadeIn 1s 0.5s forwards;
  }

  .cinematic__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--white);
    letter-spacing: 1px;
    margin-bottom: 1rem;
    opacity: 0;
    animation: cineFadeIn 1s 0.8s forwards;
  }

  .cinematic__line {
    width: 60px;
    height: 2px;
    background: var(--gold-500);
    margin-bottom: 1rem;
    opacity: 0;
    animation: cineLineGrow 1s 1.1s forwards;
  }

  .cinematic__tagline {
    font-size: 0.9375rem;
    color: var(--cream-300);
    letter-spacing: 2px;
    opacity: 0;
    animation: cineFadeIn 1s 1.4s forwards;
  }

  @keyframes cineFadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes cineLineGrow {
    from { opacity: 0; width: 0; }
    to   { opacity: 1; width: 60px; }
  }

  @media (max-width: 640px) {
    .cinematic {
      height: 45vh;
      min-height: 280px;
    }
  }
</style>
