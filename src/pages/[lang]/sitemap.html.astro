---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import business from '../../data/business.json';
import { domain } from '../../data/seo';
import type { Language } from '../../i18n/types';
import { getLocalizedPath, getLocalizedSeo, getTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'hi' } },
    { params: { lang: 'mr' } },
    { params: { lang: 'gu' } },
  ];
}

const { lang: langParam } = Astro.params;
const lang: Language = (langParam || 'en') as Language;
const t = getTranslations(lang);

const urlPath = '/sitemap.html';
const pageSeo = getLocalizedSeo(urlPath, lang);
---

<Layout
  title={pageSeo.title}
  description={pageSeo.description}
  keywords={pageSeo.secondaryKeywords}
  breadcrumbs={pageSeo.breadcrumbs}
  lang={lang}
>
  <Header lang={lang} />

  <main class="sitemap-page">
    <div class="container section">
      <!-- Breadcrumb -->
      <nav class="sitemap-breadcrumb" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/', lang)}>{t.collectionDetail.breadcrumbHome}</a>
        <span class="sitemap-breadcrumb__sep">»</span>
        <span>{t.nav.sitemap}</span>
      </nav>

      <!-- Title -->
      <h1 class="sitemap-title">{t.sitemapPage.title}</h1>

      <!-- Simple Sitemap List -->
      <div class="sitemap-list-wrap">
        <ul class="sitemap-list">
          <!-- Main Pages -->
          <li>
            <a href={getLocalizedPath('/', lang)}>{t.sitemapPage.homeTitle}</a>
          </li>
          <li>
            <a href={getLocalizedPath('/sitemap.html', lang)}>{t.sitemapPage.sitemapTitle}</a>
          </li>

          <!-- Products & Fabric Collections -->
          <li>
            <span class="sitemap-category">{t.sitemapPage.productsHeading}</span>
            <ul class="sitemap-sublist">
              {business.collections.map((item) => {
                const url = getLocalizedPath(`/${item.id}`, lang);
                const loc = t.collections[item.id];
                return (
                  <li>
                    <a href={url}>{loc?.name || item.name}</a>
                  </li>
                );
              })}
            </ul>
          </li>

          <!-- XML Sitemap -->
          <li>
            <a href="/sitemap.xml" target="_blank">XML Sitemap</a>
          </li>
        </ul>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
  <MobileActionBar lang={lang} />
</Layout>

<style>
  .sitemap-page {
    padding-top: 80px;
    background-color: var(--white, #fff);
    min-height: 80vh;
  }

  /* Breadcrumb */
  .sitemap-breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    color: var(--brown-600, #6b5b4f);
  }

  .sitemap-breadcrumb a {
    color: var(--burgundy-800, #5a1a2a);
    text-decoration: none;
  }

  .sitemap-breadcrumb a:hover {
    text-decoration: underline;
  }

  .sitemap-breadcrumb__sep {
    margin: 0 0.4rem;
    color: var(--brown-400, #a09080);
  }

  /* Title */
  .sitemap-title {
    font-family: var(--font-display, serif);
    font-size: 2rem;
    color: var(--burgundy-900, #3d0c1c);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--cream-300, #e8ddd0);
  }

  /* List wrapper */
  .sitemap-list-wrap {
    max-width: 700px;
  }

  /* Main list */
  .sitemap-list {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0;
  }

  .sitemap-list > li {
    margin-bottom: 0.6rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .sitemap-list a {
    color: var(--burgundy-800, #5a1a2a);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .sitemap-list a:hover {
    color: var(--gold-600, #b8860b);
    text-decoration: underline;
  }

  /* Category label (non-link parent items) */
  .sitemap-category {
    font-weight: 600;
    color: var(--burgundy-900, #3d0c1c);
  }

  /* Nested sub-list */
  .sitemap-sublist {
    list-style: circle;
    padding-left: 1.5rem;
    margin: 0.3rem 0 0.5rem;
  }

  .sitemap-sublist > li {
    margin-bottom: 0.35rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  .sitemap-sublist a {
    color: var(--burgundy-800, #5a1a2a);
    text-decoration: none;
  }

  .sitemap-sublist a:hover {
    color: var(--gold-600, #b8860b);
    text-decoration: underline;
  }
</style>
