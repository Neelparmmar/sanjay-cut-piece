---
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/decorative.css';
import '../styles/animations.css';
import { domain } from '../data/seo';
import business from '../data/business.json';
import type { Language } from '../i18n/types';
import { getLanguageFromPath, getCleanPath, getLocalizedPath, getLocalizedSeo } from '../i18n/utils';
import { getTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonical?: string;
  ogImage?: string;
  schemaType?: string;
  breadcrumbs?: { name: string; item: string }[];
  lang?: Language;
}

const rawPath = Astro.url.pathname;
const detectedLang = getLanguageFromPath(rawPath);

const {
  lang = detectedLang,
  ogImage = '/images/hero-background.png',
  schemaType,
} = Astro.props;

const cleanPath = getCleanPath(rawPath);
const pageSeo = getLocalizedSeo(cleanPath, lang);

const title = Astro.props.title || pageSeo.title;
const description = Astro.props.description || pageSeo.description;
const keywords = Astro.props.keywords || [pageSeo.primaryKeyword, ...pageSeo.secondaryKeywords];
const breadcrumbs = Astro.props.breadcrumbs || pageSeo.breadcrumbs;
const effectiveSchemaType = schemaType || pageSeo.schemaType;

const currentLocalizedRelative = getLocalizedPath(cleanPath, lang);
const canonical = Astro.props.canonical || `${domain}${currentLocalizedRelative}`;
const canonicalURL = new URL(canonical);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${domain}${ogImage}`;

const localeMap: Record<Language, string> = {
  en: 'en_IN',
  hi: 'hi_IN',
  mr: 'mr_IN',
  gu: 'gu_IN',
};

const hrefEn = `${domain}${getLocalizedPath(cleanPath, 'en')}`;
const hrefHi = `${domain}${getLocalizedPath(cleanPath, 'hi')}`;
const hrefMr = `${domain}${getLocalizedPath(cleanPath, 'mr')}`;
const hrefGu = `${domain}${getLocalizedPath(cleanPath, 'gu')}`;
const hrefDefault = `${domain}${getLocalizedPath(cleanPath, 'en')}`;

const schemaGraph: any[] = [
  {
    "@type": "WebSite",
    "@id": `${domain}/#website`,
    "url": domain,
    "name": "Sanjay Cut Piece",
    "alternateName": ["Sanjay Matching Centre", "Sanjay Cut Piece Centre", "संजय मॅचिंग सेंटर"],
    "description": "Quality Fabrics, Dress Materials, Cut Pieces & Matching Centre in Thane West since 1977.",
    "publisher": {
      "@id": `${domain}/#organization`
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": `${domain}/?q={search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@type": ["ClothingStore", "Store"],
    "@id": `${domain}/#organization`,
    "name": "Sanjay Cut Piece",
    "alternateName": ["संजय मॅचिंग सेंटर आणि कटपीस सेंटर", "Sanjay Cut Piece Centre", "Sanjay Matching Centre"],
    "url": domain,
    "telephone": "+919029614321",
    "foundingDate": "1977",
    "image": `${domain}/images/hero-background.png`,
    "logo": `${domain}/images/SC_logo_round_HD_tight.png`,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": `${business.address.line1}, ${business.address.line2}, ${business.address.area}`,
      "addressLocality": business.address.city,
      "addressRegion": business.address.state,
      "postalCode": business.address.pincode,
      "addressCountry": business.address.country
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "19.1934544",
      "longitude": "72.9775329"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": business.hours.daysOfWeek,
      "opens": business.hours.opens,
      "closes": business.hours.closes
    },
    "hasMap": "https://maps.app.goo.gl/XTzatKnhju5wWqSg6",
    "sameAs": [
      "https://maps.app.goo.gl/XTzatKnhju5wWqSg6",
      `https://maps.google.com/?cid=5133242001760217794`
    ],
    "priceRange": "₹₹",
    "currenciesAccepted": "INR",
    "paymentAccepted": "Cash, UPI",
    "areaServed": [
      {
        "@type": "City",
        "name": "Thane"
      },
      {
        "@type": "City",
        "name": "Thane West"
      }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Fabric & Textile Collections",
      "itemListElement": [
        { "@type": "OfferCatalog", "name": "Blouse Pieces & Blouse Material" },
        { "@type": "OfferCatalog", "name": "Dress Materials & Suit Fabric" },
        { "@type": "OfferCatalog", "name": "Dupattas" },
        { "@type": "OfferCatalog", "name": "Leggings" },
        { "@type": "OfferCatalog", "name": "Cut Pieces & Fabric Cut Pieces" },
        { "@type": "OfferCatalog", "name": "Saree Matching Fabric" },
        { "@type": "OfferCatalog", "name": "Cotton & Silk Fabrics" },
        { "@type": "OfferCatalog", "name": "Ready Made Blouses" },
        { "@type": "OfferCatalog", "name": "Saree Petticoats & Shapewear" }
      ]
    }
  }
];

if (breadcrumbs && breadcrumbs.length > 0) {
  schemaGraph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL.href}#breadcrumb`,
    "itemListElement": breadcrumbs.map((crumb, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": crumb.name,
      "item": crumb.item.startsWith('http') ? crumb.item : `${domain}${crumb.item}`
    }))
  });
}

if (effectiveSchemaType === 'Product' && cleanPath !== '/') {
  schemaGraph.push({
    "@type": "Product",
    "@id": `${canonicalURL.href}#product`,
    "name": pageSeo.h1,
    "description": description,
    "category": pageSeo.h1,
    "brand": {
      "@type": "Brand",
      "name": "Sanjay Cut Piece"
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "INR",
      "seller": {
        "@id": `${domain}/#organization`
      }
    }
  });
}

// Add FAQPage schema on homepage
if (cleanPath === '/') {
  const t = getTranslations(lang);
  schemaGraph.push({
    "@type": "FAQPage",
    "@id": `${canonicalURL.href}#faq`,
    "mainEntity": t.faq.items.map((item) => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  });
}
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

  <!-- Preconnect to fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL.href} />

  <!-- Hreflang Alternate Links -->
  <link rel="alternate" hreflang="en" href={hrefEn} />
  <link rel="alternate" hreflang="hi" href={hrefHi} />
  <link rel="alternate" hreflang="mr" href={hrefMr} />
  <link rel="alternate" hreflang="gu" href={hrefGu} />
  <link rel="alternate" hreflang="x-default" href={hrefDefault} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Sanjay Cut Piece — Fabric Store & Matching Centre in Thane" />
  <meta property="og:locale" content={localeMap[lang]} />
  <meta property="og:site_name" content="Sanjay Cut Piece" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content="Sanjay Cut Piece — Fabric Store & Matching Centre in Thane" />

  <!-- Geo Meta -->
  <meta name="geo.region" content="IN-MH" />
  <meta name="geo.placename" content="Thane" />

  <!-- Theme Color -->
  <meta name="theme-color" content="#4A0E1C" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Schema.org Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": schemaGraph
  })} />
</head>
<body>
  <slot />

  <!-- Scroll Reveal Script (Minimal vanilla JS) -->
  <script>
    // IntersectionObserver for scroll-reveal animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.reveal').forEach(el => {
      observer.observe(el);
    });

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const href = this.getAttribute('href');
        if (href) {
          const target = document.querySelector(href);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
            // Close mobile menu if open
            const mobileMenu = document.getElementById('mobile-menu');
            if (mobileMenu && mobileMenu.classList.contains('active')) {
              mobileMenu.classList.remove('active');
              document.body.style.overflow = '';
            }
          }
        }
      });
    });
  </script>
</body>
</html>
